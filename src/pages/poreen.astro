---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { LOOP_KM, CHECKPOINTS } from '../lib/poreen-route.js';
import { POREEN_API } from '../lib/poreen';
import { site } from '../lib/site';
import '../styles/poreen.css';

const loop = Math.round(LOOP_KM).toLocaleString('en-IE');
const cps = CHECKPOINTS.length;
const chips = ['3K', '5K', '8K', '10K', 'Half'];
const kinds = [
  ['run', '🏃', 'Solo run'],
  ['club', '🐆', 'Club session'],
  ['parkrun', '🌳', 'parkrun'],
  ['race', '🏅', 'Race'],
];
---
<Base
  title="Poreen: Run Ireland Together"
  description={`The Porterstown Panthers' run around Ireland. Log your km and move along a ${loop} km route past ${cps} checkpoints, from Hook Lighthouse to Malin Head. Leaderboard, stamps and awards.`}
  ogImage="/og-poreen.png"
>
  <div class="poreen" data-api={POREEN_API}>
    <!-- Hero: where the club is right now -->
    <section class="pr-hero">
      <div class="pr-hero-slash" aria-hidden="true"></div>
      <div class="wrap">
        <div class="eyebrow">Club challenge <span class="pr-day" data-day>#001</span></div>
        <h1>Poreen</h1>
        <p class="pr-hero-sub">Run Ireland <span class="hl">together</span></p>

        <div class="pr-status" aria-live="polite">
          <div class="pr-total">
            <span class="pr-label">The Panthers have run</span>
            <span class="pr-total-km"><span data-club-km>0</span><small>km</small></span>
          </div>
          <div class="pr-status-text">
            <p class="pr-where" data-club-where>On the start line in Dublin</p>
            <p class="pr-next" data-club-next>{loop} km of road and {cps} checkpoints ahead.</p>
          </div>
        </div>

        <div class="pr-rail" data-rail aria-hidden="true">
          <div class="pr-rail-line"><span class="pr-rail-fill"></span></div>
          <div class="pr-rail-ticks"></div>
          <span class="pr-rail-cat">🐆</span>
        </div>
        <div class="pr-rail-ends" aria-hidden="true"><span>Dublin</span><span data-rail-lap>Lap 1</span><span>Dublin</span></div>

        <div class="btn-row pr-hero-cta">
          <a class="btn" href="#log">Log a run <Icon name="arrow" /></a>
          <a class="btn ghost" href="#checkpoints">See the route</a>
        </div>
      </div>
    </section>

    <!-- Map and logging -->
    <section class="section dark pr-play" id="log">
      <div class="wrap pr-play-grid">
        <div class="pr-mapcol">
          <div class="pr-map-wrap">
            <div id="prMap" class="pr-map" role="region" aria-label="Map of the Poreen route around Ireland"></div>
            <button class="pr-map-unlock" type="button" data-map-unlock hidden>Tap to move the map</button>
            <div class="pr-map-tools">
              <button type="button" data-map="club" title="Find the club">🐆<span class="sr-only">Find the club</span></button>
              <button type="button" data-map="fit" title="Whole route"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg><span class="sr-only">Show the whole route</span></button>
            </div>
          </div>
          <p class="pr-map-note" data-map-note>The 🐆 is the whole club together. Tap a runner or a checkpoint.</p>
        </div>

        <div class="pr-side">
          <div class="pr-me" data-me hidden></div>

          <form class="pr-card pr-form" id="prForm" autocomplete="off" novalidate>
            <div class="pr-form-head">
              <h2 class="pr-card-title" data-form-title>Log a run</h2>
              <button class="pr-textbtn" type="button" data-cancel-edit hidden>Cancel</button>
            </div>

            <label class="pr-field">
              <span>Your name</span>
              <input name="name" list="prRunners" maxlength="32" required placeholder="e.g. Aoife K" autocomplete="nickname" />
              <datalist id="prRunners"></datalist>
            </label>

            <div class="pr-field">
              <span id="prDistLabel">Distance</span>
              <div class="pr-dist">
                <input name="km" type="number" inputmode="decimal" min="0.1" step="0.01" required placeholder="8.4" aria-labelledby="prDistLabel" />
                <div class="pr-seg" role="group" aria-label="Units">
                  <button type="button" data-unit="km" aria-pressed="true">km</button>
                  <button type="button" data-unit="mi" aria-pressed="false">mi</button>
                </div>
              </div>
              <div class="pr-chips" aria-label="Quick distances">
                {chips.map((c) => <button type="button" class="pr-chip" data-dist={c === 'Half' ? '21.1' : String(parseInt(c))}>{c}</button>)}
              </div>
            </div>

            <div class="pr-row">
              <div class="pr-field">
                <label for="prDate">Date</label>
                <input id="prDate" name="date" type="date" required />
                <div class="pr-chips">
                  <button type="button" class="pr-chip" data-day-pick="0">Today</button>
                  <button type="button" class="pr-chip" data-day-pick="1">Yesterday</button>
                </div>
              </div>
              <label class="pr-field">
                <span>Time <em>optional</em></span>
                <input name="time" inputmode="numeric" placeholder="mm:ss" maxlength="9" />
                <small class="pr-pace" data-pace></small>
              </label>
            </div>

            <fieldset class="pr-field pr-kinds">
              <legend>Type</legend>
              <div class="pr-chips">
                {kinds.map(([v, e, l], i) => (
                  <label class="pr-chip pr-chip-radio"><input type="radio" name="kind" value={v} checked={i === 0} /><span>{e} {l}</span></label>
                ))}
              </div>
            </fieldset>

            <label class="pr-field">
              <span>Note <em>optional</em></span>
              <input name="note" maxlength="80" placeholder="Hill reps in the Park" />
            </label>

            <label class="pr-field" data-code-field hidden>
              <span>Club code</span>
              <input name="code" autocomplete="off" autocapitalize="off" placeholder="Ask the committee" />
            </label>

            <button class="btn pr-submit" type="submit" data-submit>Add my km <Icon name="arrow" /></button>
            <p class="pr-msg" data-msg role="status"></p>
          </form>
        </div>
      </div>
    </section>

    <!-- Checkpoints -->
    <section class="section pr-cps" id="checkpoints">
      <div class="wrap">
        <div class="head">
          <div>
            <div class="eyebrow">The route</div>
            <h2>{cps} checkpoints</h2>
          </div>
          <div class="pr-track-nav">
            <button type="button" class="pr-arrow" data-track="-1" aria-label="Previous checkpoints"><Icon name="prev" /></button>
            <button type="button" class="pr-arrow" data-track="1" aria-label="Next checkpoints"><Icon name="next" /></button>
          </div>
        </div>
        <p class="lede pr-cps-lede">{loop} km on real roads, paths and greenways, from Hook Lighthouse to Malin Head. When the club's combined km reach a checkpoint, it's stamped with the run that got us there.</p>
        <ol class="pr-track" data-cps tabindex="0" aria-label="Checkpoints"></ol>
      </div>
    </section>

    <!-- Leaderboard -->
    <section class="section grey pr-lb" id="leaderboard">
      <div class="wrap">
        <div class="head">
          <div>
            <div class="eyebrow">Leaderboard</div>
            <h2>Who's out front</h2>
          </div>
          <div class="tabs pr-tabs" role="group" aria-label="Leaderboard period">
            <button class="tab" type="button" data-period="week">Week</button>
            <button class="tab" type="button" data-period="month">Month</button>
            <button class="tab" type="button" data-period="all">All time</button>
          </div>
        </div>
        <div class="pr-podium" data-podium></div>
        <ol class="pr-board" data-board></ol>
      </div>
    </section>

    <!-- Activity and awards -->
    <section class="section pr-activity" id="activity">
      <div class="wrap pr-activity-grid">
        <div>
          <div class="eyebrow">Latest</div>
          <h2>Fresh miles</h2>
          <ul class="pr-feed" data-feed></ul>
          <button class="btn outline pr-more" type="button" data-feed-more hidden>Show more</button>
        </div>
        <aside class="pr-awards-col">
          <div class="eyebrow">This week</div>
          <h2>Awards</h2>
          <ul class="pr-awards" data-awards></ul>
        </aside>
      </div>
    </section>

    <!-- Club stats -->
    <section class="section dark pr-stats-sec" id="stats">
      <div class="wrap">
        <div class="head">
          <div>
            <div class="eyebrow">By the numbers</div>
            <h2>Club stats</h2>
          </div>
          <button class="btn ghost" type="button" data-share-club>Share the club's progress</button>
        </div>
        <div class="pr-stats" data-stats></div>
        <figure class="pr-chart">
          <figcaption>Club km per week</figcaption>
          <ol data-chart></ol>
        </figure>
      </div>
    </section>

    <!-- How it works -->
    <section class="section grey pr-how" id="how">
      <div class="wrap split">
        <div>
          <div class="eyebrow">How it works</div>
          <h2>Run. Log.<br />Get stamped.</h2>
          <ol class="steps">
            <li><div><h3>Run anywhere</h3><p>Club sessions, parkrun, races or a solo spin. Every km counts.</p></div></li>
            <li><div><h3>Log it here</h3><p>Your km move you around Ireland, and they push the club panther further too.</p></div></li>
            <li><div><h3>Collect stamps</h3><p>Pass a checkpoint and it goes in your passport. {cps} of them, all the way round.</p></div></li>
          </ol>
          <p class="pr-legend" data-legend></p>
        </div>
        <div>
          <div class="eyebrow">Questions</div>
          <h2>Good to know</h2>
          <div class="pr-faq">
            <details>
              <summary>What's the club code?</summary>
              <p>It keeps strangers off the leaderboard. Ask at a session or message us on Instagram <a class="link" href={site.instagram.url} rel="noopener">{site.instagram.handle}</a>. You only enter it once on each phone.</p>
            </details>
            <details>
              <summary>I made a mistake. Can I fix it?</summary>
              <p>Yes. Open your profile (tap your name) and use Edit or Delete on the run. That works on the phone you logged it from. Otherwise ask the committee.</p>
            </details>
            <details>
              <summary>Is the route real?</summary>
              <p>Yes: {loop} km on real roads, paths and greenways, mapped with OpenStreetMap. It follows the coast anticlockwise from Dublin and skips ferries, so the Shannon crossing goes via Limerick.</p>
            </details>
            <details>
              <summary>What happens after a full lap?</summary>
              <p>You start lap two from the Ha'penny Bridge. Your stamps stay in your passport.</p>
            </details>
            <details>
              <summary>Who can see my runs?</summary>
              <p>Everything you log, including your name and notes, is public on this page. Use a first name and initial if you prefer.</p>
            </details>
            <details class="pr-committee" id="committee">
              <summary>Committee tools</summary>
              <div data-admin></div>
            </details>
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="cta-band"><div class="wrap"><h2>Not a Panther yet?</h2><a class="btn" href="/join">Join the club <Icon name="arrow" /></a></div></section>

  <dialog class="pr-dialog pr-profile" data-profile aria-labelledby="prProfileName"></dialog>
  <dialog class="pr-dialog pr-celebrate" data-celebrate aria-labelledby="prCelebrateTitle"></dialog>
  <div class="pr-toast" data-toast role="status" aria-live="polite" hidden></div>
  <canvas class="pr-confetti" data-confetti hidden aria-hidden="true"></canvas>
</Base>

<script>
  import '../scripts/poreen/main.js';
</script>
