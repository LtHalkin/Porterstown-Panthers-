---
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, cleanPath } from '../lib/site';

interface Props { title: string; description: string; ogImage?: string; jsonLd?: object[]; noindex?: boolean }
const { title, description, ogImage = '/og-image.png', jsonLd = [], noindex = false } = Astro.props;
const full = title.includes('Porterstown Panthers') ? title : `${title} | Porterstown Panthers`;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site).href;
const og = new URL(ogImage, Astro.site).href;
const club = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: site.name,
  description: 'Community running club in Porterstown, Dublin 15.',
  sport: 'Running',
  telephone: site.phone.href,
  url: new URL('/', Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Porterstown', addressRegion: 'Dublin 15', addressCountry: 'IE' },
  sameAs: [site.instagram.url],
};
---
<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IE" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {[club, ...jsonLd].map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) els.forEach((e) => e.classList.add('in'));
      else {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
        els.forEach((e) => io.observe(e));
      }
    </script>
  </body>
</html>
